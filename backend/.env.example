# ── Base de datos ─────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=ecommerce_db
DB_PORT=3306

# Para cloud (Railway, Render) — si se define, ignora las variables DB_* individuales
# DATABASE_URL=mysql://user:password@host:port/database

# ── Servidor ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── JWT ───────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=minimo_64_caracteres_aleatorios_aqui

# ── Stripe ────────────────────────────────────────────────────
# Obtener en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Cloudinary ────────────────────────────────────────────────
# Obtener en: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (Nodemailer) ────────────────────────────────────────
# Para Gmail usar contraseña de aplicación (no la contraseña normal)
MAILER_HOST=smtp.gmail.com
MAILER_PORT=587
MAILER_USER=tu_email@gmail.com
MAILER_PASS=tu_app_password_aqui
EMAIL_FROM="TechMarket <noreply@techmarket.com>"

# ── CORS ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Orígenes adicionales separados por coma (opcional)
CORS_EXTRA_ORIGINS=http://localhost:5174
